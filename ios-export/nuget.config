<?xml version="1.0" encoding="utf-8"?>
<!-- 本地配置：国内直连 Azure China NuGet CDN，避开 api.nuget.org 302 中转导致的并发连接饥饿超时。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="azure-cn" value="https://nuget.azure.cn/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
